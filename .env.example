# ملف نموذجي — انسخه إلى .env (غير مرفوع إلى Git) واملأه محليًا. لا تضع قيمًا حقيقية هنا.

# ---- يُستخدم فقط في rls-tests.mjs (على جهازك، لا على الموقع) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...        # المفتاح العام فقط
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_PARENT_A_EMAIL=
TEST_PARENT_A_PASSWORD=
TEST_PARENT_B_EMAIL=
TEST_PARENT_B_PASSWORD=

# ---- أسرار Edge Function (تُضبط بأمر supabase secrets set وليس في ملف) ----
# ALLOWED_ORIGINS=https://USER.github.io
# SITE_URL=https://USER.github.io/REPO
# SUPABASE_SERVICE_ROLE_KEY يُحقن تلقائيًا في Supabase — لا تكتبه في أي مكان.
